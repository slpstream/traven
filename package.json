{
  "name": "traven",
  "version": "0.2.7",
  "description": "Embeddable MIT-licensed WYSIWYM Markdown Editor built on CodeMirror 6",
  "license": "MIT",
  "author": "SLPStream / Freedomware.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slpstream/traven.git"
  },
  "bugs": {
    "url": "https://github.com/slpstream/traven/issues"
  },
  "homepage": "https://github.com/slpstream/traven#readme",
  "type": "module",
  "main": "dist/traven.js",
  "unpkg": "dist/traven.js",
  "jsdelivr": "dist/traven.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=esm --outfile=dist/traven.js --loader:.css=css",
    "watch": "esbuild src/index.js --bundle --format=esm --outfile=dist/traven.js --loader:.css=css --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "codemirror": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@lezer/markdown": "^1.3.2",
    "@replit/codemirror-vim": "^6.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
